# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Google Cloud / Gemini ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
# Set GOOGLE_CLOUD_PROJECT to route the Extractor through Vertex AI, or set a key
# here to use the Gemini API directly. One or the other, not both.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- ClickHouse (accessed via the MCP server, not directly) ---
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=goldenrod
CLICKHOUSE_MCP_URL=

# --- App ---
PORT=8080
PRODUCTION_ID=demo

# --- Access ---
# 1 locally: the interface may pick an identity, and X-Goldenrod-Subject is honoured.
# 0 behind Cloud IAP: identity comes from X-Goog-Authenticated-User-Email and nothing else.
GOLDENROD_IDENTITY_CHOOSER=1
